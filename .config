{
  // Service category. Possible values:
  //   "EU registration / Brexit"
  //   "Citizenship"
  //   "Travel document"
  //   "Residence permit"
  //   "Temporary protection - Тимчасовий захист"
  "service_category": "Residence permit",

  // Service within the chosen category. Possible values per category:
  //
  // EU registration / Brexit:
  //   "1. Registration of an EU citizen"
  //   "2. Card for a family member of an EU citizen"
  //   "3. Brexit appointments"
  //
  // Citizenship:
  //   "Citizenship matters"
  //
  // Travel document:
  //   "1. Alien's passport"
  //   "2. Refugee travel document"
  //
  // Residence permit:
  //   "1. Work"
  //   "2. Family"
  //   "3. Study"
  //   "4. Other grounds"
  //   "5. Permanent residence permit"
  //   "6. Renewal of a permanent residence permit card"
  //   "7. Renewal of residence permit card"
  //
  // Temporary protection:
  //   "Temporary protection: Application for a residence permit card - ..."
  "service": "5. Permanent residence permit",

  // Office to check. Use "all" to check every office.
  // Possible values:
  //   "all"
  //   "Helsinki service point (Malmi)"
  //   "International House Helsinki"
  //   "Tampere service point"
  //   "Turku / Raisio service point"
  //   "Oulu service point"
  //   "Lappeenranta service point"
  //   "Kuopio service point"
  //   "Lahti service point"
  //   "Vaasa service point"
  //   "Rovaniemi service point"
  //   "Joensuu police station"
  //   "Mariehamn service point"
  //   "Pori police station"
  //   "Jyväskylä Valtion virastotalo"
  //   "Mikkeli Valtion virastotalo"
  "office": "Lahti service point",

  // Number of people attending (including the main applicant). Range: 1–6.
  // Each person must have their own filled application.
  "people": 3,

  // Set to true if the applicants are family members applying together.
  // Requires "people" to be 2 or more.
  // false → individual or group booking (mode: SINGLE / GROUP)
  // true  → family booking (mode: FAMILY)
  "family": true

  // Your currently reserved appointment time in ISO 8601 format.
  // The script will only alert you if an earlier slot is found.
  // Remove this field (or set to null) if you have no reservation yet —
  // the script will then report the first available slot.
  // "reserved_time": "2026-10-15T09:00:00"
}
